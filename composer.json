{
    "name": "crustum/structarmed-cakephp",
    "description": "StructArmed preset for CakePHP 5 conventions (Controller/Component, Table/Entity/Behavior, View/Cell/Helper, Command)",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "boundwize/structarmed": "~0.14"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.5",
        "cakephp/cakephp-codesniffer": "^5.0",
        "phpstan/phpstan": "^2.0",
        "rector/rector": "^2.5"
    },
    "autoload": {
        "psr-4": {
            "Crustum\\StructArmed\\Cake\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Crustum\\StructArmed\\Cake\\Tests\\": "tests/"
        }
    },
     "scripts": {
        "check": [
            "@cs-check",
            "@rector-check",
            "@test",
            "@stan"
        ],
        "fix": [
            "@cs-fix",
            "@rector-fix",
            "@cs-fix",
            "@analyse"
        ],
        "analyse": [
            "@stan"
        ],
        "cs-check": "phpcs -p --standard=phpcs.xml src/ tests/",
        "cs-fix": "phpcbf --standard=phpcs.xml src/ tests/",
        "test": "phpunit",
        "rector-check": "vendor/bin/rector process --dry-run",
        "rector-fix": "vendor/bin/rector process",
        "stan": "phpstan analyse src/"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
